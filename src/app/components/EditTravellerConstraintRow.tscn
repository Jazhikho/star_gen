[gd_scene format=3]

[node name="EditTravellerConstraintRow" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="Row"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)
text = "Size Code:"

[node name="Option" type="OptionButton" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ApplyButton" type="Button" parent="Row"]
layout_mode = 2
tooltip_text = "Constrain radius and mass to this Traveller size code"
text = "Apply"

[node name="ClearButton" type="Button" parent="Row"]
layout_mode = 2
tooltip_text = "Remove Traveller constraint"
text = "Clear"

[node name="StatusLabel" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 10
text = "Status"
